<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Outlook to Obsidian — Office Add-in Manifest
  =============================================
  This manifest is already pointed at its live host:
    https://hellb0rg.github.io/send-to-obsidian   (GitHub Pages, main branch, root)

  IF YOU FORK: replace every occurrence of that URL with your own Pages URL
    (https://<your-github-username>.github.io/<repo-name>) and generate a fresh
    <Id> below — PowerShell: [guid]::NewGuid()

  SIDELOADING (per user):
    Outlook → Get Add-ins → My add-ins → Custom Addins → Add a custom add-in →
    Add from file → select this manifest.xml
    (https://aka.ms/olksideload routes to the same dialog)

  LOCAL DEVELOPMENT (serve the folder yourself):
    1. npx office-addin-dev-certs install        (installs a trusted localhost cert)
    2. npx http-server . -S -C <cert> -K <key> -p 3000
    3. Point the URLs below at https://localhost:3000
    4. Sideload as above

  PRODUCTION DEPLOYMENT (Microsoft 365 admin):
    Upload this manifest.xml at admin.microsoft.com → Settings → Integrated apps

  VALIDATE: npx office-addin-manifest validate manifest.xml
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">

  <!-- Unique add-in identifier — do NOT change after deployment -->
  <Id>aa32eddb-4fda-4d24-b9bc-d754a36d1f5c</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>hellb0rg</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>

  <DisplayName DefaultValue="Send to Obsidian"/>
  <Description DefaultValue="Extract a calendar appointment or email message and create a formatted Obsidian note."/>

  <IconUrl DefaultValue="https://hellb0rg.github.io/send-to-obsidian/icon128.png"/>
  <HighResolutionIconUrl DefaultValue="https://hellb0rg.github.io/send-to-obsidian/icon128.png"/>
  <SupportUrl DefaultValue="https://github.com/hellb0rg/send-to-obsidian"/>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <!-- Mailbox 1.5: needed for makeEwsRequestAsync and for the
           MessageRead / AppointmentOrganizer command surfaces -->
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>

  <!-- Legacy FormSettings (classic clients): task pane shown when reading an
       appointment or message (ItemRead), or editing an appointment (ItemEdit).
       Modern clients use the VersionOverrides ribbon buttons below instead. -->
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://hellb0rg.github.io/send-to-obsidian/taskpane.html"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://hellb0rg.github.io/send-to-obsidian/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <!--
    ReadWriteMailbox: required to call makeEwsRequestAsync, the original
    source of attendee RSVP status.  EWS is being retired for Exchange Online
    (October 2026) and most tenants already block it, so that call usually
    fails and the add-in falls back to Office.js appointmentResponse.

    ReadItem is therefore sufficient in practice.  On the fallback path RSVP
    status is still populated for meetings you organize; for meetings you were
    merely invited to, all attendees appear under "No Response" (a platform
    limitation, not a permission one).
  -->
  <Permissions>ReadWriteMailbox</Permissions>

  <!-- Show on calendar appointments (read & compose) and on read email messages -->
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <!-- VersionOverrides: ribbon button in modern Outlook -->
  <VersionOverrides
    xmlns="http://schemas.microsoft.com/office/mailappversionoverrides"
    xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>

          <!-- Required even when no function-only commands are used -->
          <FunctionFile resid="Commands.Url"/>

          <!-- Attendee view: reading a meeting you were invited to -->
          <ExtensionPoint xsi:type="AppointmentAttendeeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="obsidianGroupAttendee">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="obsidianBtnAttendee">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- Read message: extracting an email to an Obsidian note -->
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="obsidianGroupMessage">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="obsidianBtnMessage">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

          <!-- Organizer view: composing / editing a meeting you own -->
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="obsidianGroupOrganizer">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="obsidianBtnOrganizer">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16"  DefaultValue="https://hellb0rg.github.io/send-to-obsidian/icon16.png"/>
        <bt:Image id="Icon.32"  DefaultValue="https://hellb0rg.github.io/send-to-obsidian/icon48.png"/>
        <bt:Image id="Icon.80"  DefaultValue="https://hellb0rg.github.io/send-to-obsidian/icon128.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url"  DefaultValue="https://hellb0rg.github.io/send-to-obsidian/taskpane.html"/>
        <bt:Url id="Commands.Url"  DefaultValue="https://hellb0rg.github.io/send-to-obsidian/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label"   DefaultValue="Obsidian"/>
        <bt:String id="Button.Label"  DefaultValue="Create Note"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="Extract this meeting or email and create an Obsidian note"/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
